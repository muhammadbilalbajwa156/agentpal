# AgentPal Phase 1 — example configuration. PLACEHOLDER VALUES ONLY.
# Environment variables are read directly; export them or use your process manager.
# Never commit a real .env (it is git-ignored).

# Risk policy: thresholds, limits, rule weights, approved merchants
AGENTPAL_POLICY_PATH=config/risk_policy.json

# SQLite file for development persistence (requests, ledger, trust records, audit log).
# Pre-P0 database files are refused; move them aside to create a fresh one.
AGENTPAL_DB_PATH=agentpal_dev.db

# Trusted operator spending policy: budgets and limits per agent and currency (P0.2/P0.5).
# Request fields such as monthly_budget are never trusted.
# The shipped file is a DEMO configuration ("configuration": "demo") with placeholder
# budgets, not approved spending limits. For an owner-approved setup, start from
# config/spend_policy.operator.example.json: an operator configuration cannot contain a
# default budget, so unlisted agents are rejected (NO_SPENDING_POLICY).
AGENTPAL_SPEND_POLICY_PATH=config/spend_policy.json

# Trusted model digests (P0.7d). With integrity required, an unpinned or mismatching
# model backend is unavailable and the deterministic rules are used instead.
AGENTPAL_MODEL_MANIFEST_PATH=config/model_manifest.json
AGENTPAL_REQUIRE_MODEL_INTEGRITY=true
# GGUF models must be on storage the service user cannot write (permission bits are
# checked; this does NOT protect against a privileged root process). The verified bytes
# are copied to a private 0700 staging directory and only that 0400 copy is loaded. Set a
# dedicated path on a local filesystem; the default is <system tmp>/agentpal-models-<uid>.
# The first (cold-cache) hash of the 1.1 GB GGUF took ~117 s in testing (~3.5 s warm);
# start-up waits for it before serving.
AGENTPAL_REQUIRE_READ_ONLY_MODEL_STORAGE=true
# AGENTPAL_MODEL_STAGING_DIR=/var/lib/agentpal/model-staging

# Analyzer backends, tried in order; the deterministic heuristic is always the final fallback.
# Deterministic rules are the security authority. Models are ADVISORY: they can add a
# review, never block, unblock or relax a recommendation. `ml` is not a proven fraud
# detector; `heuristic` alone gives rules-only behaviour.
# Options: llamacpp, ollama, ml, heuristic
AGENTPAL_ANALYZER_CHAIN=ml,heuristic

# Trained baseline classifier (plain JSON, created by `python -m agentpal train`)
AGENTPAL_ML_MODEL_PATH=artifacts/baseline_classifier.json

# Optional local open-weight LLM via llama.cpp (no API key; `make install-llm`)
AGENTPAL_LLAMACPP_MODEL_PATH=artifacts/models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# Optional local open-weight LLM via an Ollama server (no API key)
AGENTPAL_OLLAMA_URL=http://127.0.0.1:11434
AGENTPAL_OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Upper bound for every model backend call (llama.cpp, Ollama, ML); on timeout the next
# backend / the deterministic rules are used (P0.7a)
AGENTPAL_MODEL_TIMEOUT_SECONDS=30

AGENTPAL_LOG_LEVEL=INFO
AGENTPAL_MAX_REQUEST_BYTES=32768

# ---- API security (docs/SECURITY_AUDIT.md) ----
# development (default) or production. Production refuses: authentication disabled, no
# token file, a "demo" spend policy, model integrity / read-only storage switched off,
# an in-memory database, and non-loopback Host names. It does NOT add TLS, and the API
# still binds loopback only (owner decision 10).
AGENTPAL_ENV=development

# required (default): every endpoint except /health needs `Authorization: Bearer <token>`.
# disabled_insecure_dev: NO authentication or authorization. Any local process can assess
# as any agent and read every assessment. Loopback demo use only; refused in production
# and for a non-loopback bind; logged as a WARNING at start-up and marked on every
# response with `X-AgentPal-Auth: disabled-insecure-dev`.
AGENTPAL_AUTH_MODE=required

# JSON file with the SHA-256 hashes of API tokens (never the tokens themselves). Create
# entries with:
#   python -m agentpal new-token --agent agent_demo_001 --id agent-001-key-1 \
#       --append /etc/agentpal/api_tokens.json
#   python -m agentpal new-token --operator --id ops-1 --append /etc/agentpal/api_tokens.json
# The plaintext token is printed once on stderr; give it to the agent's secret store.
# An agent token authenticates exactly one agent_id; an operator token can read any
# assessment but cannot submit one. Keep the file outside the repository.
# AGENTPAL_API_TOKENS_FILE=/etc/agentpal/api_tokens.json

# In-memory sliding-window limits per 60 s, PER PROCESS (with N workers, up to N times
# this). Exceeding one answers 429 {"error": "rate_limited"} with Retry-After.
AGENTPAL_RATE_LIMIT_PER_TOKEN=60
AGENTPAL_RATE_LIMIT_PER_PEER=300

# Host header allow-list (DNS-rebinding defence for the loopback API).
AGENTPAL_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# ---- Phase 2 placeholders (NOT used in Phase 1; never put real values in this file) ----
# PAYPAL_CLIENT_ID=replace-me
# PAYPAL_CLIENT_SECRET=replace-me
# PAYPAL_WEBHOOK_ID=replace-me
# WHATSAPP_ACCESS_TOKEN=replace-me
# WHATSAPP_APP_SECRET=replace-me
