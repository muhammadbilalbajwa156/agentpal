# Secrets / local config
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# Local development persistence
*.db
*.sqlite
*.sqlite3

# Generated data & model artifacts (reproducible via `make data` / `make train`)
data/*
!data/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.gguf
*.safetensors
*.joblib

# Evaluation runs (a reference copy lives in docs/)
reports/*
!reports/.gitkeep

# Training outputs (SFT data, adapters, exported models): reproducible, never committed
build/

# Public PayPal certificates (no private keys) used for webhook verification and its tests
!agentpal/providers/certs/*.pem
!tests/fixtures/paypal/*.pem
